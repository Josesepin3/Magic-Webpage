<%
  const iconName = typeof icon !== 'undefined' && icon ? icon : 'spark';
  const iconClass = typeof className !== 'undefined' && className ? className : '';
%>
<svg class="<%= iconClass %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <% if (iconName === 'shield') { %>
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
  <% } else if (iconName === 'layers') { %>
    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
    <polyline points="2 17 12 22 22 17"></polyline>
    <polyline points="2 12 12 17 22 12"></polyline>
  <% } else if (iconName === 'layout') { %>
    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
    <line x1="3" y1="9" x2="21" y2="9"></line>
    <line x1="9" y1="21" x2="9" y2="9"></line>
  <% } else if (iconName === 'circle') { %>
    <circle cx="12" cy="12" r="9"></circle>
    <circle cx="12" cy="12" r="3"></circle>
  <% } else if (iconName === 'grid') { %>
    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
  <% } else { %>
    <path d="M12 3v18M3 12h18"></path>
  <% } %>
</svg>
