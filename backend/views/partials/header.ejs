<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title><%= typeof title !== 'undefined' ? title : 'Magic' %></title>
</head>
<body>

    <header class="site-header">
        <div class="glass" aria-hidden="true">
            <span class="glass-layer glass-layer--1"></span>
            <span class="glass-layer glass-layer--2"></span>
            <span class="glass-layer glass-layer--3"></span>
            <span class="glass-layer glass-layer--4"></span>
            <span class="glass-layer glass-layer--5"></span>
            <span class="glass-layer glass-layer--6"></span>
            <span class="glass-layer glass-layer--7"></span>
            <span class="glass-layer glass-layer--8"></span>
            <span class="glass-layer glass-layer--9"></span>
            <span class="glass-layer glass-layer--10"></span>
            <span class="glass-layer glass-layer--11"></span>
            <span class="glass-layer glass-layer--12"></span>
            <span class="glass-layer glass-layer--13"></span>
            <span class="glass-layer glass-layer--14"></span>
            <span class="glass-layer glass-layer--15"></span>
            <span class="glass-layer glass-layer--16"></span>
            <span class="glass-layer glass-layer--17"></span>
            <span class="glass-layer glass-layer--18"></span>
            <span class="glass-layer glass-layer--19"></span>
            <span class="glass-layer glass-layer--20"></span>
        </div>
        <h1 class="site-title"><a href="/" style="text-decoration: none;" aria-label="MagicOS"><img class="site-logo" src="/img/magic-logo-white.svg" alt="MagicOS"></a></h1>
        <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" title="Mostrar menú">
            <span class="menu-icon">☰</span>
            <span class="visually-hidden">Mostrar menú</span>
        </button>
        <nav id="main-nav" class="navbar" role="navigation">
            <ul>
                <li><a href="/productos">Productos</a></li>
                <li><a href="/contacto">Contacto</a></li>
            </ul>
        </nav>
    </header>
