<%- include('../partials/header') %>

    <main>

        <section id="que_es">
            <div class="hero">
                <a href="/productos" class="hero-back-btn">← Volver a productos</a>
                <img src="/img/MagicOS.png" alt="MagicOS Logo">
                <div class="hero-overlay">
                    <p>Magia en la punta de tus dedos</p>
                </div>
            </div>
        </section>

        <section id="funciones">
            <h2>Funciones</h2>
            <ul class="manual-features-grid">
                <li class="feature-card feature-card-ui" style="grid-column: 1 / span 3; grid-row: 1 / span 1;">
                    <div class="card-grid">
                        <div class="card-content">
                            <h3 class="card-title">Interfaz de usuario intuitiva</h3>
                            <div class="card-body">
                                <p class="card-desc">Interfaz limpia y accesible que reduce la curva de aprendizaje.</p>
                            </div>
                        </div>
                        <div class="card-visual">
                            <img src="/img/shell.svg" alt="shell" />
                        </div>
                    </div>
                </li>

                <li class="feature-card feature-card-security" style="grid-column: 1 / span 1; grid-row: 2 / span 1;">
                    <div class="feature-media">
                        <span class="feature-icon" aria-hidden="true">
                            <svg class="feature-icon-img" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="m 2 0 c -0.550781 0 -1 0.449219 -1 1 v 8 c 0 2.5 1.816406 4.246094 3.445312 5.332031 c 1.628907 1.085938 3.238282 1.617188 3.238282 1.617188 c 0.207031 0.070312 0.425781 0.070312 0.632812 0 c 0 0 1.609375 -0.53125 3.238282 -1.617188 c 1.628906 -0.085937 3.445312 -2.832031 3.445312 -5.332031 v -8 c 0 -0.550781 -0.449219 -1 -1 -1 z m 1 2 h 10 v 7 c 0 1.5 -1.183594 2.753906 -2.554688 3.667969 c -1.214843 0.808593 -2.179687 1.128906 -2.445312 1.226562 c -0.265625 -0.097656 -1.230469 -0.417969 -2.445312 -1.226562 c -1.371094 -0.914063 -2.554688 -2.167969 -2.554688 -3.667969 z m 1 1 v 6 c 0 1 0.867188 2.007812 2.109375 2.835938 c 0.933594 0.621093 1.472656 0.785156 1.890625 0.949218 v -9.785156 z m 0 0" fill="currentColor"/>
                            </svg>
                        </span>
                    </div>
                    <h3 class="card-title">Seguridad y privacidad</h3>
                    <div class="card-body">
                        <p class="card-desc">Cifrado y protección integrada para mantener tus datos seguros y tus comunicaciones privadas.</p>
                    </div>
                </li>

                <li class="feature-card feature-card-open" style="grid-column: 2 / span 1; grid-row: 2 / span 1;">
                    <div class="feature-media">
                        <span class="feature-icon" aria-hidden="true">
                            <svg class="feature-icon-img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path fill="none" d="M0 0H24V24H0z"/>
                                <path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10 0 4.13-2.504 7.676-6.077 9.201l-2.518-6.55C14.354 14.148 15 13.15 15 12c0-1.657-1.343-3-3-3s-3 1.343-3 3c0 1.15.647 2.148 1.596 2.652l-2.518 6.55C4.504 19.675 2 16.13 2 12 2 6.477 6.477 2 12 2z"/>
                            </svg>
                        </span>
                    </div>
                    <h3 class="card-title">Open Source</h3>
                    <div class="card-body">
                        <p class="card-desc">Código abierto y colaboración transparente entre contribuyentes.</p>
                    </div>
                </li>

                <li class="feature-card feature-card-compat" style="grid-column: 4 / span 1; grid-row: 1 / span 2;">
                    <div class="card-grid">
                        <div class="card-visual">
                            <img src="/img/apps.svg" alt="apps" />
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Compatibilidad amplia</h3>
                            <div class="card-body">
                                <p class="card-desc">Funciona con una gran variedad de aplicaciones y formatos.</p>
                            </div>
                        </div>
                    </div>
                </li>

                <li class="feature-card feature-card-performance" style="grid-column: 3 / span 1; grid-row: 2 / span 1;">
                    <div class="feature-media">
                        <span class="feature-icon" aria-hidden="true">
                            <svg class="feature-icon-img" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="m 8.96875 0 c -0.332031 0.0117188 -0.640625 0.1875 -0.816406 0.46875 l -5 8 c -0.105469 0.171875 -0.152344 0.355469 -0.152344 0.53125 v 1 h 3 v 5 c 0 1.003906 1.316406 1.378906 1.847656 0.53125 l 5 -8 c 0.105469 -0.171875 0.152344 -0.355469 0.148438 -0.53125 h 0.003906 v -1 h -3 v -5 c 0 -0.5625 -0.464844 -1.015625 -1.03125 -1 z m 0 0" fill="currentColor"/>
                            </svg>
                        </span>
                    </div>
                    <h3 class="card-title">Rendimiento optimizado</h3>
                    <div class="card-body">
                        <p class="card-desc">El sistema está ajustado para aprovechar cada CPU al máximo y mantener una experiencia ágil incluso en cargas exigentes.</p>
                    </div>
                </li>
            </ul>
        </section>

        <section id="get_involved">
            <h2>Involúcrese</h2>
            <h3>Si quieres involucrarte con MagicOS, aquí está cómo puedes contribuir.</h3>
            <ul class="steps-grid">
                <li>
                    <span class="step-number">1</span>
                    <p>Únete a nuestra comunidad en línea y participa en discusiones.</p>
                </li>
                <li>
                    <span class="step-number">2</span>
                    <p>Contribuye al desarrollo de MagicOS a través de GitHub.</p>
                </li>
                <li>
                    <span class="step-number">3</span>
                    <p>Ayuda a traducir MagicOS a otros idiomas.</p>
                </li>
                <li>
                    <span class="step-number">4</span>
                    <p>Comparte tus ideas y sugerencias para mejorar MagicOS.</p>
                </li>
                <li>
                    <span class="step-number">5</span>
                    <p>Participa en eventos y hackathons organizados por la comunidad.</p>
                </li>
            </ul>
        </section>

    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const manualGrid = document.querySelector('.manual-features-grid');
            if (manualGrid) {
                manualGrid.addEventListener('click', (e) => {
                    if (window.matchMedia('(max-width: 1060px)').matches) {
                        return;
                    }
                    const card = e.target.closest('.feature-card');
                    if (!card || !manualGrid.contains(card)) return;
                    const currently = manualGrid.querySelector('.expanded');
                    if (currently && currently !== card) {
                        currently.classList.remove('expanded');
                    }
                    card.classList.toggle('expanded');
                });
            }
        });
    </script>

<%- include('../partials/footer') %>