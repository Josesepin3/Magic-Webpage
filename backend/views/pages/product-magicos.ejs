<%- include('../partials/header') %>

    <main class="magicos-cinema">

        <section id="que_es">
            <div class="hero magicos-hero">
                <a href="/productos" class="hero-back-btn">← <span class="hero-back-text">Volver a productos</span></a>
                <div class="magicos-glow" aria-hidden="true"></div>
                <div class="magicos-hero-inner">
                    <img class="magicos-hero-logo" src="/img/MagicOS.png" alt="MagicOS Logo" width="1920" height="1080" fetchpriority="high">
                    <p class="magicos-hero-tagline">Magia en la punta de tus dedos</p>
                </div>
            </div>
        </section>

        <section id="funciones" class="hm-section">
            <div class="hm-section-head mop-head">
                <span class="hm-eyebrow">Funciones</span>
                <h2>Un sistema operativo que pone tu privacidad primero.</h2>
                <p>Interfaz intuitiva, seguridad radical y rendimiento optimizado, todo con procesamiento estrictamente local.</p>
            </div>
            <div class="mop-carousel" data-mop-carousel aria-roledescription="carousel">
                <div class="mop-slides" data-mop-slides>
                    <article class="mop-slide mop-slide--ui" data-mop-slide>
                        <button type="button" class="mop-pill" data-mop-pill="0" aria-label="Ir a: Interfaz de usuario intuitiva">
                            <svg class="mop-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                        </button>
                        <div class="mop-card">
                            <div class="mop-card-text">
                                <h3 class="mop-card-title">Interfaz de usuario intuitiva</h3>
                                <p class="mop-card-desc">Interfaz limpia y accesible que reduce la curva de aprendizaje.</p>
                            </div>
                            <div class="mop-card-visual">
                                <img class="mop-card-img" src="/img/shell.svg" alt="shell">
                            </div>
                        </div>
                    </article>

                    <article class="mop-slide mop-slide--security" data-mop-slide>
                        <button type="button" class="mop-pill" data-mop-pill="1" aria-label="Ir a: Seguridad y privacidad">
                            <svg class="mop-pill-icon" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m 2 0 c -0.550781 0 -1 0.449219 -1 1 v 8 c 0 2.5 1.816406 4.246094 3.445312 5.332031 c 1.628907 1.085938 3.238282 1.617188 3.238282 1.617188 c 0.207031 0.070312 0.425781 0.070312 0.632812 0 c 0 0 1.609375 -0.53125 3.238282 -1.617188 c 1.628906 -0.085937 3.445312 -2.832031 3.445312 -5.332031 v -8 c 0 -0.550781 -0.449219 -1 -1 -1 z m 1 2 h 10 v 7 c 0 1.5 -1.183594 2.753906 -2.554688 3.667969 c -1.214843 0.808593 -2.179687 1.128906 -2.445312 1.226562 c -0.265625 -0.097656 -1.230469 -0.417969 -2.445312 -1.226562 c -1.371094 -0.914063 -2.554688 -2.167969 -2.554688 -3.667969 z m 1 1 v 6 c 0 1 0.867188 2.007812 2.109375 2.835938 c 0.933594 0.621093 1.472656 0.785156 1.890625 0.949218 v -9.785156 z m 0 0" fill="currentColor"/></svg>
                        </button>
                        <div class="mop-card">
                            <div class="mop-card-text">
                                <h3 class="mop-card-title">Seguridad y privacidad</h3>
                                <p class="mop-card-desc">Cifrado y protección integrada para mantener tus datos seguros y tus comunicaciones privadas.</p>
                            </div>
                            <div class="mop-card-visual">
                                <svg class="mop-card-icon" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m 2 0 c -0.550781 0 -1 0.449219 -1 1 v 8 c 0 2.5 1.816406 4.246094 3.445312 5.332031 c 1.628907 1.085938 3.238282 1.617188 3.238282 1.617188 c 0.207031 0.070312 0.425781 0.070312 0.632812 0 c 0 0 1.609375 -0.53125 3.238282 -1.617188 c 1.628906 -0.085937 3.445312 -2.832031 3.445312 -5.332031 v -8 c 0 -0.550781 -0.449219 -1 -1 -1 z m 1 2 h 10 v 7 c 0 1.5 -1.183594 2.753906 -2.554688 3.667969 c -1.214843 0.808593 -2.179687 1.128906 -2.445312 1.226562 c -0.265625 -0.097656 -1.230469 -0.417969 -2.445312 -1.226562 c -1.371094 -0.914063 -2.554688 -2.167969 -2.554688 -3.667969 z m 1 1 v 6 c 0 1 0.867188 2.007812 2.109375 2.835938 c 0.933594 0.621093 1.472656 0.785156 1.890625 0.949218 v -9.785156 z m 0 0" fill="currentColor"/></svg>
                            </div>
                        </div>
                    </article>

                    <article class="mop-slide mop-slide--performance" data-mop-slide>
                        <button type="button" class="mop-pill" data-mop-pill="2" aria-label="Ir a: Rendimiento optimizado">
                            <svg class="mop-pill-icon" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m 8.96875 0 c -0.332031 0.0117188 -0.640625 0.1875 -0.816406 0.46875 l -5 8 c -0.105469 0.171875 -0.152344 0.355469 -0.152344 0.53125 v 1 h 3 v 5 c 0 1.003906 1.316406 1.378906 1.847656 0.53125 l 5 -8 c 0.105469 -0.171875 0.152344 -0.355469 0.148438 -0.53125 h 0.003906 v -1 h -3 v -5 c 0 -0.5625 -0.464844 -1.015625 -1.03125 -1 z m 0 0" fill="currentColor"/></svg>
                        </button>
                        <div class="mop-card">
                            <div class="mop-card-text">
                                <h3 class="mop-card-title">Rendimiento optimizado</h3>
                                <p class="mop-card-desc">El sistema está ajustado para aprovechar cada CPU al máximo y mantener una experiencia ágil incluso en cargas exigentes.</p>
                            </div>
                            <div class="mop-card-visual">
                                <svg class="mop-card-icon" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m 8.96875 0 c -0.332031 0.0117188 -0.640625 0.1875 -0.816406 0.46875 l -5 8 c -0.105469 0.171875 -0.152344 0.355469 -0.152344 0.53125 v 1 h 3 v 5 c 0 1.003906 1.316406 1.378906 1.847656 0.53125 l 5 -8 c 0.105469 -0.171875 0.152344 -0.355469 0.148438 -0.53125 h 0.003906 v -1 h -3 v -5 c 0 -0.5625 -0.464844 -1.015625 -1.03125 -1 z m 0 0" fill="currentColor"/></svg>
                            </div>
                        </div>
                    </article>

                    <article class="mop-slide mop-slide--open" data-mop-slide>
                        <button type="button" class="mop-pill" data-mop-pill="3" aria-label="Ir a: Open Source">
                            <svg class="mop-pill-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10 0 4.13-2.504 7.676-6.077 9.201l-2.518-6.55C14.354 14.148 15 13.15 15 12c0-1.657-1.343-3-3-3s-3 1.343-3 3c0 1.15.647 2.148 1.596 2.652l-2.518 6.55C4.504 19.675 2 16.13 2 12 2 6.477 6.477 2 12 2z"/></svg>
                        </button>
                        <div class="mop-card">
                            <div class="mop-card-text">
                                <h3 class="mop-card-title">Open Source</h3>
                                <p class="mop-card-desc">Código abierto y colaboración transparente entre contribuyentes.</p>
                            </div>
                            <div class="mop-card-visual">
                                <svg class="mop-card-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10 0 4.13-2.504 7.676-6.077 9.201l-2.518-6.55C14.354 14.148 15 13.15 15 12c0-1.657-1.343-3-3-3s-3 1.343-3 3c0 1.15.647 2.148 1.596 2.652l-2.518 6.55C4.504 19.675 2 16.13 2 12 2 6.477 6.477 2 12 2z"/></svg>
                            </div>
                        </div>
                    </article>

                    <article class="mop-slide mop-slide--compat" data-mop-slide>
                        <button type="button" class="mop-pill" data-mop-pill="4" aria-label="Ir a: Compatibilidad amplia">
                            <svg class="mop-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                        </button>
                        <div class="mop-card">
                            <div class="mop-card-text">
                                <h3 class="mop-card-title">Compatibilidad amplia</h3>
                                <p class="mop-card-desc">Funciona con una gran variedad de aplicaciones y formatos.</p>
                            </div>
                            <div class="mop-card-visual">
                                <img class="mop-card-img" src="/img/apps.svg" alt="apps">
                            </div>
                        </div>
                    </article>
                </div>
                <div class="mop-meta" aria-hidden="true">
                    <span class="mop-counter"><span class="mop-counter-num">1</span><span class="mop-counter-div"> / </span><span class="mop-counter-total">5</span></span>
                    <span class="mop-progress"><span class="mop-progress-bar"></span></span>
                </div>
            </div>
        </section>

        <section id="get_involved">
            <div class="hm-section-head mop-head mop-head--on-accent">
                <span class="hm-eyebrow">Comunidad</span>
                <h2>Involúcrate</h2>
                <p>Si quieres contribuir con MagicOS, aquí está cómo puedes ayudar.</p>
            </div>
            <ul class="steps-grid">
                <li>
                    <span class="step-number">1</span>
                    <p>Únete a nuestra comunidad en línea y participa en discusiones.</p>
                </li>
                <li>
                    <span class="step-number">2</span>
                    <p>Contribuye al desarrollo de MagicOS a través de GitHub.</p>
                </li>
                <li>
                    <span class="step-number">3</span>
                    <p>Ayuda a traducir MagicOS a otros idiomas.</p>
                </li>
                <li>
                    <span class="step-number">4</span>
                    <p>Comparte tus ideas y sugerencias para mejorar MagicOS.</p>
                </li>
                <li>
                    <span class="step-number">5</span>
                    <p>Participa en eventos y hackathons organizados por la comunidad.</p>
                </li>
            </ul>
        </section>

    </main>

<%- include('../partials/footer') %>