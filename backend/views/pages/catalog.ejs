<%- include('../partials/header') %>

    <main>
        <section>
            <h2>Catálogo</h2>
            <p>Explora los productos del ecosistema MagicOS.</p>
            <% if (products.length === 0) { %>
                <p style="text-align: center; opacity: 0.6; margin-top: 60px;">Próximamente...</p>
            <% } else { %>
                <ul class="manual-features-grid">
                    <% products.forEach(product => { %>
                        <li class="feature-card" style="grid-column: span 1; grid-row: span 1;">
                            <h3 class="card-title"><%= product.name %></h3>
                            <% if (product.tagline) { %>
                                <p style="font-size: 0.9rem; opacity: 0.7;"><%= product.tagline %></p>
                            <% } %>
                            <p><%= product.description %></p>
                            <% if (product.base_price) { %>
                                <p style="font-weight: 700;">Desde $<%= product.base_price %></p>
                            <% } %>
                            <% if (product.status === 'coming_soon') { %>
                                <span style="display: inline-block; margin-top: 8px; padding: 4px 12px; background: rgba(255,255,255,0.1); border-radius: 20px; font-size: 0.8rem;">Próximamente</span>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </section>
    </main>

<%- include('../partials/footer') %>
