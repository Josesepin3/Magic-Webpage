<%- include('../partials/header') %>

    <main class="product-page">
      <section class="product-hero">
        <div class="product-hero-content">
          <div class="product-hero-visual" data-reveal>
            <%- include('../partials/blackbox-badge') %>
          </div>
          <h1 class="product-name" data-reveal><%= product.name %></h1>
          <% if (product.tagline) { %>
            <p class="product-tagline" data-reveal data-reveal-delay="60"><%= product.tagline %></p>
          <% } %>
          <% if (product.status === 'coming_soon') { %>
            <span class="product-badge" data-reveal data-reveal-delay="120">Próximamente</span>
          <% } %>
          <p class="product-description" data-reveal data-reveal-delay="180"><%= product.description %></p>
          <div class="product-actions" data-reveal data-reveal-delay="240">
            <a href="/productos" class="btn btn-secondary">Ver todos los productos</a>
          </div>
        </div>
      </section>

      <% if (features.length > 0) { %>
        <section class="product-features">
          <% features.forEach((feature, index) => { %>
            <article class="feature-section" data-reveal data-reveal-delay="<%= index * 80 %>">
              <h2><%= feature.title %></h2>
              <p><%= feature.description %></p>
            </article>
          <% }) %>
        </section>
      <% } %>
    </main>

<%- include('../partials/footer') %>