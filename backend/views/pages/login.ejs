<%- include('../partials/header') %>

    <main>
        <section class="admin-login">
            <form id="login-form" class="login-card" data-reveal novalidate>
                <h2>Administración</h2>
                <p class="login-intro">Accede con tu cuenta de administrador.</p>

                <div class="form-field">
                    <label for="login-username">Correo</label>
                    <input type="email" id="login-username" name="email" placeholder="admin@magicos.io" autocomplete="email" required>
                    <span class="field-error" data-error-for="email" aria-live="polite"></span>
                </div>

                <div class="form-field">
                    <label for="login-password">Contraseña</label>
                    <input type="password" id="login-password" name="password" placeholder="••••••••" autocomplete="current-password" required>
                    <span class="field-error" data-error-for="password" aria-live="polite"></span>
                </div>

                <div class="login-actions">
                    <button type="submit">Entrar</button>
                    <p class="form-status" role="status" aria-live="polite" hidden></p>
                </div>
            </form>
        </section>
    </main>

<%- include('../partials/footer') %>
