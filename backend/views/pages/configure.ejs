<%- include('../partials/header') %>

    <main class="configure-page" data-product-id="<%= product.id %>" data-base-price="<%= product.base_price %>">
      <div class="configure-layout">
        <h1 class="configure-title" data-reveal>Configurar <%= product.name %></h1>

        <div class="configure-options">

          <% Object.entries(groupedOptions).forEach(([groupName, groupOptions], index) => { %>
            <fieldset class="option-group" data-group="<%= groupName %>" data-reveal data-reveal-delay="<%= index * 60 %>">
              <legend class="option-group-title"><%= groupName %></legend>
              <div class="option-group-options">
                <% groupOptions.forEach(opt => { %>
                  <label class="option-card <%= opt.is_default ? 'selected' : '' %>">
                    <input type="radio"
                           name="<%= groupName %>"
                           value="<%= opt.id %>"
                           data-price="<%= opt.price_modifier %>"
                           <%= opt.is_default ? 'checked' : '' %>>
                    <span class="option-label"><%= opt.label %></span>
                    <% if (opt.description) { %>
                      <span class="option-desc"><%= opt.description %></span>
                    <% } %>
                    <% if (opt.price_modifier > 0) { %>
                      <span class="option-price">+$<%= opt.price_modifier.toLocaleString() %></span>
                    <% } else if (opt.is_default) { %>
                      <span class="option-price included">Incluido</span>
                    <% } %>
                  </label>
                <% }) %>
              </div>
            </fieldset>
          <% }) %>
        </div>

        <aside class="configure-summary" data-reveal data-reveal-delay="180">
          <div class="summary-sticky">
            <h2>Resumen</h2>
            <p class="summary-product"><%= product.name %></p>
            <ul class="summary-selections" id="summary-selections">
              <% for (const [groupName, groupOptions] of Object.entries(groupedOptions)) { %>
                <% const defaultOpt = groupOptions.find(o => o.is_default) || groupOptions[0] %>
                <li><strong><%= groupName %>:</strong> <%= defaultOpt.label %></li>
              <% } %>
            </ul>
            <p class="summary-total">
              Total: <span id="total-price">$<%= product.base_price.toLocaleString() %></span>
            </p>
          </div>
        </aside>
      </div>

      <div class="mobile-total-bar">
        <span class="mobile-total-label">Total</span>
        <span class="mobile-total-price" id="total-price-mobile">$<%= product.base_price.toLocaleString() %></span>
      </div>

      <script id="options-data" type="application/json"><%= JSON.stringify(options) %></script>
      <script src="/js/components/ProductConfigurator.js"></script>
    </main>

<%- include('../partials/footer') %>